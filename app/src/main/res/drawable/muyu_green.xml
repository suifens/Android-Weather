    <item>
        <shape android:shape="oval">
            <solid android:color="#FFC8E6C9" />
        </shape>
    </item>
    <item
        android:top="20dp"
        android:left="60dp"
        android:right="60dp"
        android:bottom="180dp">
        <shape android:shape="oval">
            <solid android:color="#FFD8F0D9" />
        </shape>
    </item>
    <item
        android:top="180dp"
        android:left="80dp"
        android:right="80dp"
        android:bottom="220dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF8B4513" />

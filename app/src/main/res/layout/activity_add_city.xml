<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.activity.AddCityActivity">

    <ImageView
        android:id="@+id/topBgImg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintDimensionRatio="375:150"
        app:srcCompat="@drawable/bg_search_top" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/locationLayout"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:background="@drawable/bg_white_16"
        android:layout_marginTop="-30dp"
        android:elevation="10dp"
        app:layout_constraintTop_toBottomOf="@+id/topBgImg"
        >

        <ImageView
            android:id="@+id/iconLocation"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/icon_location"
            app:layout_constraintBottom_toBottomOf="@+id/tvCurLocation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvCurLocation" />

        <TextView
            android:id="@+id/tvCurLocation"
            style="@style/Marquee_Text"
            android:layout_height="wrap_content"
            android:layout_width="0dp"
            android:fontFamily="sans-serif-black"
            android:layout_marginStart="2dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="6dp"
            android:gravity="center_vertical"
            android:text="@string/tip_location"
            android:textColor="@color/color_333"
            android:textSize="18sp"
            app:layout_constraintEnd_toStartOf="@+id/btnRefresh"
            app:layout_constraintStart_toEndOf="@+id/iconLocation"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvLocSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="34dp"
            android:layout_marginBottom="16dp"
            android:text="@string/tip_location_get"
            android:textColor="@color/color_515151_50"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />

        <ImageButton
            android:id="@+id/btnGetPos"
            android:layout_width="88dp"
            android:layout_height="30dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/btn_location" />

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@color/color_clear"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/ic_refresh" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/locationLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:gravity="center_vertical"
                android:text="@string/tip_hot_city"
                android:textColor="@color/color_333"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/cityListImgV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/cityListTv"
                app:layout_constraintEnd_toEndOf="@+id/cityListTv"
                app:layout_constraintTop_toTopOf="@+id/cityListTv"
                app:srcCompat="@drawable/ic_more_rg" />

            <TextView
                android:id="@+id/cityListTv"
                style="@style/HomeCard_Show_All"
                android:layout_alignParentEnd="true"
                android:text="我的城市"
                android:paddingEnd="20dp"
                android:layout_marginEnd="28dp"
                app:layout_constraintBottom_toBottomOf="@+id/textView3"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/textView6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tip_hot_city_sub"
                android:textColor="@color/color_515151_50"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="@+id/textView3"
                app:layout_constraintTop_toBottomOf="@+id/textView3" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_top_city"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView6" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/searchLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/back_white"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/private_station_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        >

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_search"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent" />


        <ImageView
            android:id="@+id/emptyView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintVertical_bias="0.3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/img_empty_city" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/private_station_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backButton"
            style="@style/ItemButtonStyle"
            android:src="@drawable/ic_back_w"
            android:layout_marginStart="15dp"
            android:layout_marginBottom="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/et_search"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="4dp"
            android:layout_marginEnd="10dp"
            android:layout_toEndOf="@+id/backButton"
            android:background="@drawable/shape_search"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:hint="@string/add_city"
            android:maxLength="20"
            android:paddingStart="13dp"
            android:singleLine="true"
            android:textColor="@color/color_212121"
            android:textColorHint="@color/color_d7d7d7"
            android:textSize="16sp"
            app:drawableLeftCompat="@drawable/ic_search_gray"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/cancelBtn"
            app:layout_constraintStart_toEndOf="@+id/backButton" />

        <TextView
            android:id="@+id/et_search_temp"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="4dp"
            android:layout_marginEnd="10dp"
            android:layout_toEndOf="@+id/backButton"
            android:background="@drawable/bg_white_20_r12"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:hint="@string/add_city"
            android:maxLength="20"
            android:paddingStart="13dp"
            android:textColor="@color/color_212121"
            android:textColorHint="@color/white_30"
            android:textSize="16sp"
            app:drawableLeftCompat="@drawable/ic_search"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/cancelBtn"
            app:layout_constraintStart_toEndOf="@+id/backButton" />

        <Button
            android:id="@+id/searchButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/color_clear"
            app:layout_constraintTop_toTopOf="@+id/et_search_temp"
            app:layout_constraintBottom_toBottomOf="@+id/et_search_temp"
            app:layout_constraintEnd_toEndOf="@+id/et_search_temp"
            app:layout_constraintStart_toStartOf="@+id/et_search_temp" />

        <Button
            android:id="@+id/cancelBtn"
            style="@style/ClearButtonStyle"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="4dp"
            android:fontFamily="sans-serif"
            android:text="@string/button_cancel"
            android:textColor="@color/color_515151_50"
            android:textSize="16sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
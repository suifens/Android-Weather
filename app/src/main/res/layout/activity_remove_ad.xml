<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/private_station_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_007bff_00c4ff"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/button_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="7dp"
                android:layout_marginBottom="4dp"
                android:background="@color/color_clear"
                android:src="@drawable/ic_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="设置"
                android:textColor="@color/white"
                android:textSize="20dp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/status_section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:padding="20dp"
            app:layout_constraintTop_toBottomOf="@id/top_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/status_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="去广告时长"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/remaining_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="剩余: "
                android:textColor="@color/white"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/status_title" />

            <TextView
                android:id="@+id/remaining_time_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00天06小时"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@+id/remaining_label"
                app:layout_constraintBottom_toBottomOf="@id/remaining_label"
                app:layout_constraintStart_toEndOf="@+id/remaining_label" />

            <Button
                android:id="@+id/renew_button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="续时长"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:background="@drawable/bg_button_orange"
                android:paddingHorizontal="16dp"
                android:minWidth="0dp"
                app:layout_constraintTop_toTopOf="@id/remaining_label"
                app:layout_constraintBottom_toBottomOf="@id/remaining_time_text"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/info_banner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="看视频领去广告时长、免费享无广告天气预报"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:background="@drawable/bg_info_banner"
                android:padding="12dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/remaining_time_text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/status_section"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Video Tasks Section -->
            <TextView
                android:id="@+id/video_tasks_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="获得去广告权益时长"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <TextView
                android:id="@+id/video_tasks_desc1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="每天可以领取7次去广告时长奖励,全部看完"
                android:textColor="@color/color_8f"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/video_tasks_title"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/video_tasks_desc2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="可获得4天无广告天气预报"
                android:textColor="@color/color_8f"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/video_tasks_desc1"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Video Tasks Grid -->
            <GridLayout
                android:id="@+id/video_tasks_grid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:rowCount="2"
                app:layout_constraintTop_toBottomOf="@id/video_tasks_desc2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <include
                    android:id="@+id/video_task_1"
                    layout="@layout/item_video_task"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp" />

                <include
                    android:id="@+id/video_task_2"
                    layout="@layout/item_video_task"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp" />

                <include
                    android:id="@+id/video_task_3"
                    layout="@layout/item_video_task"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp" />

                <include
                    android:id="@+id/video_task_4"
                    layout="@layout/item_video_task"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp" />

                <include
                    android:id="@+id/video_task_5"
                    layout="@layout/item_video_task"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp" />

                <include
                    android:id="@+id/video_task_6"
                    layout="@layout/item_video_task"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp" />

                <include
                    android:id="@+id/video_task_7"
                    layout="@layout/item_video_task"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp" />

            </GridLayout>

            <TextView
                android:id="@+id/video_tasks_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="第2天可重新领取7次奖励"
                android:textColor="@color/color_8f"
                android:textSize="12sp"
                app:layout_constraintTop_toBottomOf="@id/video_tasks_grid"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Daily Rewards Section -->
            <TextView
                android:id="@+id/daily_rewards_title1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="连续7天看视频领取奖励,必得免费7~100天"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/video_tasks_note"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/daily_rewards_title2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="无广告天气预报"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/daily_rewards_title1"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Daily Rewards Grid -->
            <GridLayout
                android:id="@+id/daily_rewards_grid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:rowCount="2"
                app:layout_constraintTop_toBottomOf="@id/daily_rewards_title2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <Button
                    android:id="@+id/day_1_button"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_columnWeight="1"
                    android:text="第1天"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:background="@drawable/bg_daily_reward_current"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/day_2_button"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_columnWeight="1"
                    android:text="第2天"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:background="@drawable/bg_daily_reward_locked"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/day_3_button"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_columnWeight="1"
                    android:text="第3天"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:background="@drawable/bg_daily_reward_locked"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/day_4_button"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_columnWeight="1"
                    android:text="第4天"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:background="@drawable/bg_daily_reward_locked"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/day_5_button"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_columnWeight="1"
                    android:text="第5天"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:background="@drawable/bg_daily_reward_locked"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/day_6_button"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_columnWeight="1"
                    android:text="第6天"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:background="@drawable/bg_daily_reward_locked"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/day_7_button"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_columnWeight="1"
                    android:text="第7天"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:background="@drawable/bg_daily_reward_locked"
                    android:layout_margin="4dp" />

            </GridLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>


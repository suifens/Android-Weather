<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetBtn"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/backgroundView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_radius12_black_10" />

    <include layout="@layout/widget_layout"
        android:id="@+id/layout_widget"
        android:visibility="gone"/>

    <include layout="@layout/widget_layout_small"
        android:id="@+id/layout_widget_small"
        android:visibility="gone"/>

</FrameLayout>
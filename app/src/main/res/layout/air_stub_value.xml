<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="360dp"
    android:gravity="center">

    <com.goodtech.tq.views.CircleProgressView
        android:id="@+id/progress_view"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <com.goodtech.tq.utils.font.AlternateBoldTextView
        android:id="@+id/tv_air_aqi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="60dp"
        android:textColor="@color/white"
        android:text="12"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@+id/progress_view"
        app:layout_constraintBottom_toBottomOf="@+id/progress_view"
        app:layout_constraintStart_toStartOf="@+id/progress_view"
        app:layout_constraintEnd_toEndOf="@+id/progress_view"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13dp"
        android:textColor="@color/white"
        android:text="@string/title_aqi"
        app:layout_constraintBottom_toTopOf="@+id/tv_air_aqi"
        app:layout_constraintStart_toStartOf="@+id/progress_view"
        app:layout_constraintEnd_toEndOf="@+id/progress_view"
        />

    <TextView
        android:id="@+id/tv_aqi_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.8"
        android:background="@drawable/bg_stroke_circle_white"
        android:paddingStart="10dp"
        android:paddingTop="2dp"
        android:paddingEnd="10dp"
        android:paddingBottom="2dp"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="13dp"
        app:layout_constraintEnd_toEndOf="@+id/progress_view"
        app:layout_constraintStart_toStartOf="@+id/progress_view"
        app:layout_constraintTop_toBottomOf="@+id/tv_air_aqi" />

    <TextView
        android:id="@+id/tv_aqi_remind"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="30dp"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="13dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progress_view" />

    <TextView
        android:id="@+id/tv_update_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13dp"
        android:textColor="@color/white"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_aqi_remind"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
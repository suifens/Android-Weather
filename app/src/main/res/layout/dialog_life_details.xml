<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="360dp"
    android:background="@drawable/bg_bottom_round"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingBottom="10dp" >

    <TextView
        android:id="@+id/textView4"
        style="@style/Black_Text"
        android:layout_marginStart="26dp"
        android:layout_marginTop="26dp"
        android:text="详情"
        android:textColor="@color/color_9b9b9b"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/lifeImageV"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="60dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_title"
        style="@style/Black_Text"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:textColor="@color/color_383838"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/lifeImageV"
        app:layout_constraintTop_toTopOf="@+id/lifeImageV" />

    <TextView
        android:id="@+id/tv_value"
        style="@style/Black_Text"
        android:layout_marginTop="10dp"
        android:layout_marginStart="12dp"
        android:textColor="@color/color_515151"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@+id/lifeImageV"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        />

    <ImageView
        android:id="@+id/weatherIcon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="30dp"
        app:layout_constraintBottom_toTopOf="@+id/view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lifeImageV" />

    <TextView
        android:id="@+id/weatherInfoTv"
        style="@style/Black_Text"
        android:layout_marginStart="10dp"
        tools:text="晴"
        android:textColor="@color/color_9b9b9b"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@+id/view"
        app:layout_constraintStart_toEndOf="@+id/weatherIcon"
        app:layout_constraintTop_toBottomOf="@+id/lifeImageV" />

    <TextView
        android:id="@+id/weatherTempTv"
        style="@style/Black_Text"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toTopOf="@+id/view"
        app:layout_constraintStart_toEndOf="@+id/weatherInfoTv"
        app:layout_constraintTop_toBottomOf="@+id/lifeImageV"
        tools:text="30/20°"
        android:textColor="@color/color_9b9b9b"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/cityTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintBottom_toTopOf="@+id/view"
        app:layout_constraintTop_toBottomOf="@+id/lifeImageV"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="厦门"
        android:textColor="@color/color_9b9b9b"
        android:textSize="14sp" />

    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_line"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toBottomOf="@+id/lifeImageV"
        tools:layout_editor_absoluteX="30dp" />

    <TextView
        android:id="@+id/desTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="20dp"
        android:lineSpacingExtra="6dp"
        android:textColor="@color/color_4a4a4a"
        android:textSize="14sp"
        android:alpha="0.5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view" />

    <ImageButton
        android:id="@+id/closeBtn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:background="@color/color_clear"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_close_n" />


</androidx.constraintlayout.widget.ConstraintLayout>

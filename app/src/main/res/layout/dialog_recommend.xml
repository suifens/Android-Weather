<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    >

    <androidx.cardview.widget.CardView
        android:id="@+id/imageView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/bg_recommend"
            />

        <ImageView
            android:id="@+id/closeImgV"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="7dp"
            android:layout_marginTop="7dp"
            android:layout_gravity="end|top"
            android:padding="7dp"
            app:srcCompat="@drawable/ic_close_n" />

    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/shareBtn"
        style="@style/ConfirmButtonStyle"
        android:textSize="16sp"
        android:text="去分享并获取纯净天气"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginBottom="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/forgetBtn"
        android:layout_width="70dp"
        android:layout_height="30dp"
        android:background="@color/color_clear"
        android:textColor="@color/white_80"
        android:textSize="12sp"
        android:text="不再提醒"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@+id/shareBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>

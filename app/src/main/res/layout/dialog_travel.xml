<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="440dp"
    android:background="@drawable/bg_bottom_round"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingBottom="10dp" >

    <TextView
        android:id="@+id/textView4"
        style="@style/Black_Text"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:text="出行天气"
        android:textColor="@color/color_383838"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/closeBtn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:background="@color/color_clear"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_close_n" />

    <View
        android:id="@+id/line1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_line"
        android:layout_marginTop="145dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"
        />

    <TextView
        android:id="@+id/curCityTv"
        style="@style/Black_Text"
        android:layout_marginStart="26dp"
        android:layout_marginBottom="18dp"
        tools:text="出行天气"
        android:textColor="@color/black"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/line1" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/ic_travel_to"
        app:layout_constraintTop_toTopOf="@id/curCityTv"
        app:layout_constraintBottom_toBottomOf="@+id/curCityTv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/travelCityTv"
        style="@style/Black_Text"
        android:layout_marginEnd="26dp"
        android:layout_marginBottom="18dp"
        android:text="出行城市"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:alpha="0.3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/line1" />

    <TextView
        android:id="@+id/timeTv"
        style="@style/Black_Text"
        android:layout_marginStart="26dp"
        tools:text="11月30日"
        android:textColor="@color/black"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/line1"
        app:layout_constraintBottom_toBottomOf="@id/line2" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="今天"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:alpha="0.5"
        app:layout_constraintStart_toEndOf="@+id/timeTv"
        app:layout_constraintTop_toTopOf="@+id/line1"
        app:layout_constraintBottom_toBottomOf="@id/line2" />

    <View
        android:id="@+id/line2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_line"
        android:layout_marginTop="60dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@+id/line1"
        />

    <Button
        android:id="@+id/showDetailBtn"
        style="@style/ConfirmButtonStyle"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="60dp"
        android:text="查询"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>

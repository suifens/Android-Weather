<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activity.WeatherActivity">

<!--    <VideoView-->
<!--        android:id="@+id/videoView"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="0dp"-->
<!--        app:layout_constraintDimensionRatio="720:1280"-->
<!--        app:layout_constraintTop_toTopOf="parent"-->
<!--        />-->

    <ImageView
        android:id="@+id/weatherImgV"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@drawable/gradient_weather_main"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/private_station_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/listImgView"
            style="@style/ItemButtonStyle"
            android:src="@drawable/ic_list"
            android:layout_marginStart="15dp"
            android:layout_marginBottom="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />


        <ImageView
            android:id="@+id/iv_loc"
            android:layout_width="10dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_loc_w"
            android:layout_marginEnd="4dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/cityNameTv"
            app:layout_constraintEnd_toStartOf="@+id/cityNameTv"
            app:layout_constraintTop_toTopOf="@+id/cityNameTv"
            />

        <TextView
            android:id="@+id/cityNameTv"
            style="@style/Marquee_Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:maxWidth="180dp"
            android:textColor="@color/white_80"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@+id/listImgView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/listImgView"
            tools:text="不一样的你我不一样的你我不一样的你我" />

        <LinearLayout
            android:id="@+id/ll_round"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />

        <ImageView
            android:id="@+id/btn_add"
            style="@style/ItemButtonStyle"
            android:layout_marginBottom="2dp"
            android:layout_marginEnd="2dp"
            android:src="@drawable/ic_add"
            android:padding="9dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_share" />

        <ImageView
            android:id="@+id/btn_share"
            style="@style/ItemButtonStyle"
            android:layout_marginBottom="2dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_share"
            android:padding="10dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:paddingBottom="60dp"
        app:layout_constraintTop_toBottomOf="@+id/private_station_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<com.goodtech.weatherlib.view.swiperefresh.MySwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/refreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragment.WeatherFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.chunjing.tq.view.BindBottomLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/layout_current"
                android:layout_width="match_parent"
                android:layout_height="560dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_top_20"
                android:orientation="vertical"
                android:gravity="center" >

                <include layout="@layout/layout_day_temp" />

                <include layout="@layout/layout_tomorrow_temp" />

                <!-- Banner 广告容器 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/adBannerContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:minHeight="50dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    />

                <include layout="@layout/layout_forecast_hourly" />

                <include layout="@layout/layout_air_quality" />

                <include layout="@layout/layout_forecast_15d" />

                <include layout="@layout/layout_life_indicator" />

            </LinearLayout>

        </com.chunjing.tq.view.BindBottomLayout>

    </androidx.core.widget.NestedScrollView>
</com.goodtech.weatherlib.view.swiperefresh.MySwipeRefreshLayout>

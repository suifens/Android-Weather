<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bgHoliday"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    >

    <View
        android:id="@+id/bgView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_holiday_1" />

    <TextView
        android:id="@+id/cityNameTv"
        style="@style/Black_Text"
        android:layout_marginTop="19dp"
        android:layout_marginStart="18dp"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <TextView
        android:id="@+id/tempTv"
        style="@style/AlternateStyle"
        android:layout_marginEnd="14dp"
        android:textSize="24sp"
        app:layout_constraintTop_toTopOf="@+id/cityNameTv"
        app:layout_constraintBottom_toBottomOf="@+id/cityNameTv"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/iconImgV"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginBottom="14dp"
        android:layout_marginStart="18dp"
        tools:src="@drawable/icon5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <TextView
        android:id="@+id/phraseTv"
        style="@style/Black_Text"
        android:textColor="@color/black_50"
        android:textSize="16sp"
        tools:text="多云"
        android:layout_marginStart="6dp"
        app:layout_constraintTop_toTopOf="@+id/iconImgV"
        app:layout_constraintBottom_toBottomOf="@+id/iconImgV"
        app:layout_constraintStart_toEndOf="@+id/iconImgV"
        />

    <TextView
        android:id="@+id/descTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/color_515151_50"
        android:textSize="12sp"
        tools:text="晴"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
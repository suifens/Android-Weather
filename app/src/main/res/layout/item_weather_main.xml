<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="490dp"
    >

    <ImageView
        android:id="@+id/img_weather"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/bgTemp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            />

        <ImageView
            android:id="@+id/locationImgView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="5dp"
            android:src="@drawable/ic_loc_w"
            app:layout_constraintEnd_toStartOf="@+id/tvCity"
            app:layout_constraintTop_toTopOf="@+id/tvCity"
            app:layout_constraintStart_toStartOf="parent"
            />

        <TextView
            android:id="@+id/tvCity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="城市"
            android:layout_marginTop="18dp"
            android:layout_marginStart="36dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <TextView
            android:id="@+id/tempTv"
            style="@style/AlternateStyle"
            android:layout_width="match_parent"
            
            android:textColor="@color/white"
            android:textSize="48sp"
            tools:text="18°"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />

        <TextView
            android:id="@+id/weatherDetailTv"
            style="@style/Medium_Title"
            android:layout_width="match_parent"
            android:textColor="@color/white"
            android:textSize="14sp"
            tools:text="南风"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="30dp"
            android:layout_marginEnd="80dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <TextView
            android:id="@+id/timeTv"
            style="@style/Medium_Title"
            android:textColor="@color/white_80"
            android:textSize="12sp"
            tools:text="时间"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="112dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />

        <TextView
            android:id="@+id/tipTv"
            style="@style/Medium_Title"
            android:textColor="@color/white"
            android:textSize="14sp"
            tools:text="提示"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="145dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />

        <ImageView
            android:id="@+id/iconImgV"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="30dp"
            android:layout_marginBottom="65dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:src="@drawable/icon5" />

        <TextView
            android:id="@+id/phraseTv"
            style="@style/Black_Text"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="@+id/iconImgV"
            app:layout_constraintStart_toStartOf="@+id/iconImgV"
            app:layout_constraintTop_toBottomOf="@+id/iconImgV"
            tools:text="多云" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>


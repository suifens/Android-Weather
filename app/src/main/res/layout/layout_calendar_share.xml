<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shareView"
    android:layout_width="match_parent"
    android:layout_height="640dp"
    >

    <ImageView
        android:id="@+id/weatherBgImgV"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:srcCompat="@drawable/img_bg" />

    <ImageView
        android:id="@+id/iconImgV"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_logo" />

    <TextView
        style="@style/Black_Text"
        android:text="纯净天气"
        android:textSize="14sp"
        android:textColor="@color/white"
        android:layout_marginStart="7dp"
        app:layout_constraintStart_toEndOf="@+id/iconImgV"
        app:layout_constraintTop_toTopOf="@+id/iconImgV"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="纯净开启好心情"
        android:textSize="12sp"
        android:textColor="@color/white"
        android:layout_marginStart="7dp"
        app:layout_constraintStart_toEndOf="@+id/iconImgV"
        app:layout_constraintBottom_toBottomOf="@+id/iconImgV"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/tvDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/white_80"
            android:textSize="200sp" />

        <TextView
            android:id="@+id/tvMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-16dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/white"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/white_80"
            android:textSize="16sp" />


        <ImageView
            android:id="@+id/imgWeather"
            android:layout_width="30dp"
            android:layout_height="36dp"
            android:layout_marginTop="60dp" />

        <TextView
            android:id="@+id/tvWeather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/white"
            android:textSize="18sp" />

    </LinearLayout>

    <ImageView
        android:id="@+id/iv_loc"
        android:layout_width="10dp"
        android:layout_height="12dp"
        android:src="@drawable/ic_loc_w"
        android:layout_marginStart="30dp"
        android:layout_marginTop="4dp"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="@+id/cityNameTv"
        app:layout_constraintStart_toStartOf="parent"
        />

    <TextView
        android:id="@+id/cityNameTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="250dp"
        tools:text="不一样的你我不"
        android:textColor="@color/white_80"
        android:textSize="14sp"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="4dp"
        android:visibility="invisible"
        app:layout_constraintStart_toEndOf="@+id/iv_loc"
        app:layout_constraintBottom_toBottomOf="parent"
         />

    <ImageView
        android:id="@+id/qrCodeImgV"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:srcCompat="@drawable/img_qr_code" />

</androidx.constraintlayout.widget.ConstraintLayout>
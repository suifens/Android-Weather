<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/private_station_bar"
    android:layout_width="match_parent"
    android:layout_height="140dp"
    android:background="@color/white">

    <TextView
        android:id="@+id/tv_detail_week"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        android:textSize="14dp"
        android:alpha="0.5"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_detail_lunar"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:textColor="@color/black"
        android:textSize="30dp"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/icon_suit"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:text="宜"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="12dp"
        android:background="@drawable/bg_circle_52a255"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/icon_avoid"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_detail_suit"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="12dp"
        android:alpha="0.8"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/icon_suit"
        app:layout_constraintStart_toEndOf="@+id/icon_suit"
        app:layout_constraintTop_toTopOf="@+id/icon_suit"/>

    <TextView
        android:id="@+id/icon_avoid"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:text="忌"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="12dp"
        android:background="@drawable/bg_circle_cb5656"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_detail_avoid"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="12dp"
        android:alpha="0.8"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/icon_avoid"
        app:layout_constraintStart_toEndOf="@+id/icon_avoid"
        app:layout_constraintTop_toTopOf="@+id/icon_avoid"/>

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/private_station_bar"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:orientation="horizontal"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_weight="1"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_detail_week"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:textColor="@color/black"
            android:textSize="14dp"
            android:alpha="0.8"
            android:layout_marginStart="18dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_detail_lunar"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:textColor="@color/black"
            android:textSize="30dp"
            android:textStyle="bold"
            android:layout_marginStart="18dp"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_weight="1"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/icon_suit"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:text="宜"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="12dp"
                android:background="@drawable/bg_circle_52a255"
                app:layout_constraintBottom_toTopOf="@+id/icon_avoid"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tv_detail_suit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="16dp"
                android:lines="1"
                android:ellipsize="end"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/icon_suit"
                app:layout_constraintStart_toEndOf="@+id/icon_suit"
                app:layout_constraintTop_toTopOf="@+id/icon_suit"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/icon_avoid"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:text="忌"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="12dp"
                android:background="@drawable/bg_circle_cb5656" />

            <TextView
                android:id="@+id/tv_detail_avoid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="16dp"
                android:lines="1"
                android:ellipsize="end"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/icon_avoid"
                app:layout_constraintStart_toEndOf="@+id/icon_avoid"
                app:layout_constraintTop_toTopOf="@+id/icon_avoid"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
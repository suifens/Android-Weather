<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:visibility="invisible"
    android:id="@+id/weatherContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:orientation="vertical">

    <com.goodtech.tq.fragment.view.CurrentItemView
        android:id="@+id/item_current"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"/>

    <com.goodtech.tq.fragment.view.RecentItemView
        android:id="@+id/item_recent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"/>

    <com.goodtech.tq.fragment.view.HoursItemView
        android:id="@+id/item_hours"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="10dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center" >

        <ImageView
            android:id="@+id/btn_mental_health"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            app:srcCompat="@drawable/ic_mental_health" />

        <ImageView
            android:id="@+id/btn_eq_test"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/ic_eq" />

    </LinearLayout>

    <com.goodtech.tq.fragment.view.DailyListItemView
        android:id="@+id/item_daily_list"
        android:layout_width="match_parent"
        android:layout_height="510dp"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        />

    <FrameLayout
        android:id="@+id/item_ad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_circle_white_12"
        android:visibility="gone"
        />

    <com.goodtech.tq.fragment.view.LineTempItemView
        android:id="@+id/item_line_temp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_circle_black_12">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="生活服务指数"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_16"
            android:layout_marginTop="14dp"
            android:layout_marginStart="18dp" />

        <com.goodtech.tq.others.airQuality.view.AirLifeView
            android:id="@+id/view_life"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />

    </LinearLayout>

    <com.goodtech.tq.fragment.view.ObservationView
        android:id="@+id/item_observation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        />

    <ImageView
        android:id="@+id/btn_iq_test_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        app:srcCompat="@drawable/ic_iq_2"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"/>

</LinearLayout>

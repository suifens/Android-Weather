<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:visibility="invisible"
    android:id="@+id/weatherContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:orientation="vertical">

    <com.goodtech.tq.fragment.view.CurrentItemView
        android:id="@+id/item_current"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"/>

    <com.goodtech.tq.fragment.view.RecentItemView
        android:id="@+id/item_recent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"/>

    <com.goodtech.tq.fragment.view.HoursItemView
        android:id="@+id/item_hours"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="10dp"/>

    <com.goodtech.tq.fragment.view.DailyListItemView
        android:id="@+id/item_daily_list"
        android:layout_width="match_parent"
        android:layout_height="510dp"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_circle_black_12"
        />

    <FrameLayout
        android:id="@+id/item_ad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_circle_white_12"
        android:visibility="gone"
        />

    <com.goodtech.tq.fragment.view.LineTempItemView
        android:id="@+id/item_line_temp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_circle_black_12"
        />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/dailyViewPager"
        android:layout_width="match_parent"
        android:layout_height="510dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_circle_black_12"
        />

    <com.goodtech.tq.fragment.view.ObservationView
        android:id="@+id/item_observation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"/>

</LinearLayout>

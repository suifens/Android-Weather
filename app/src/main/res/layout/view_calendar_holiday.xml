<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/private_station_bar"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:background="@color/white"
    android:layout_marginBottom="1dp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <LinearLayout
        android:id="@+id/layout_linear"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_stroke4_48c7a1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="17dp" >

        <TextView
            android:id="@+id/tv_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="宜"
            android:gravity="center"
            android:textColor="@color/color_48c7a1"
            android:textSize="10dp" />

        <TextView
            android:id="@+id/tv_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="宜"
            android:gravity="center"
            android:textColor="@color/color_48c7a1"
            android:textSize="14dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_holiday_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="宜"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="20dp"
        android:layout_marginStart="6dp"
        app:layout_constraintTop_toTopOf="@+id/layout_linear"
        app:layout_constraintStart_toEndOf="@+id/layout_linear"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginStart="6dp"
        app:layout_constraintStart_toEndOf="@+id/layout_linear"
        app:layout_constraintTop_toBottomOf="@+id/tv_holiday_name" >

        <TextView
            android:id="@+id/tv_holiday_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="宜"
            android:gravity="center"
            android:textColor="@color/black_alpha50"
            android:textSize="14dp" />

        <TextView
            android:id="@+id/tv_holiday_length"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:background="@drawable/bg_radius4_48c7a1"
            android:text="宜"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="14dp"
            android:layout_marginStart="4dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
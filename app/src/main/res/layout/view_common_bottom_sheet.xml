<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_radius8_white" >

        <Button
            android:id="@+id/btn_sheet_first"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/color_clear"
            android:textColor="@color/black"
            android:textSize="18dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2px"
            android:background="@color/color_line" />

        <Button
            android:id="@+id/btn_sheet_second"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/color_clear"
            android:textColor="@color/black"
            android:textSize="18dp"  />


    </LinearLayout>

    <TextView
        android:id="@+id/select_cancel"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/button_cancel"
        android:textColor="@color/black_alpha50"
        android:textSize="18dp"
        android:textStyle="bold"
        android:background="@drawable/bg_radius8_white" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/linearLayout3"
    android:layout_width="match_parent"
    android:layout_height="400dp">

    <com.goodtech.tq.fragment.viewholder.HeaderItemsView
        android:id="@+id/view_items"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/layout_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="140dp"
        android:gravity="center"
        android:layout_marginTop="50dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/img_icon"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            app:srcCompat="@drawable/icon36" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_weight="1">

            <com.goodtech.tq.utils.font.AlternateBoldTextView
                android:id="@+id/tv_temperature"
                android:layout_width="wrap_content"
                android:layout_height="86dp"
                android:text="26"
                android:textColor="@color/white"
                android:textSize="64dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.goodtech.tq.utils.font.AlternateBoldTextView
                android:id="@+id/alternateBoldTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="℃"
                android:textColor="@color/white"
                android:textSize="36dp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toTopOf="@+id/tv_temperature"
                app:layout_constraintBottom_toBottomOf="@+id/tv_temperature"
                app:layout_constraintStart_toEndOf="@+id/tv_temperature" />

            <TextView
                android:id="@+id/tv_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前："
                android:textColor="@color/white"
                android:textSize="@dimen/sp_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_temperature" />

            <TextView
                android:id="@+id/tv_wx_phrase"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:text="多云"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_16"
                android:fontFamily="sans-serif-condensed-medium"
                android:layout_marginBottom="2dp"
                app:layout_constraintStart_toEndOf="@+id/tv_current"
                app:layout_constraintTop_toBottomOf="@+id/tv_temperature" />

            <TextView
                android:id="@+id/tv_rh_wrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="东风 3级｜ 湿度47%"
                android:textColor="@color/white_alpha80"
                android:textSize="13dp"
                android:gravity="bottom"
                android:layout_marginTop="2dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_current" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_notice" />

        <TextView
            android:id="@+id/tv_notice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/white"
            android:textSize="12dp"
            android:lines="1"
            android:gravity="center"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="8dp"
            android:layout_marginStart="4dp"
            />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_sign"
        android:layout_width="88dp"
        android:layout_height="42dp"
        android:src="@drawable/ic_sign"
        android:background="@color/color_clear"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="54dp"
        />

    <View
        android:id="@+id/view_sign_tip"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/bg_circle_ff3838"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="90dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"
        />


</androidx.constraintlayout.widget.ConstraintLayout>

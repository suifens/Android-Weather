<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widgetBtn"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:viewBindingIgnore="true"
    >

    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_radius12_theme_15"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <ImageView
                android:id="@+id/locationImgView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginStart="16dp"
                app:srcCompat="@drawable/ic_loc_w"
                />

            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="18dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:lines="1"
                android:ellipsize="middle"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:layout_constraintStart_toEndOf="@+id/locationImgView"
                app:layout_constraintTop_toTopOf="@+id/locationImgView"
                app:layout_constraintBottom_toBottomOf="@+id/locationImgView"
                app:layout_constraintEnd_toStartOf="@+id/qualityImgV"
                />

            <ImageView
                android:id="@+id/qualityImgV"
                android:layout_width="32dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="16dp"
                tools:src="@drawable/ic_quality_1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <ImageView
                android:id="@+id/ivWeather"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvTemp"
                style="@style/Black_Text"
                android:layout_height="33dp"
                android:layout_marginTop="4dp"
                android:textColor="@color/white"
                android:textSize="24sp"
                tools:text="29°" />

            <TextView
                android:id="@+id/tvWeather"
                style="@style/Black_Text"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="20dp"
                android:ellipsize="middle"
                android:lines="1"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="4dp"
                android:layout_marginTop="2dp"
                tools:text="今天有晴转多云的天气"
                />

            <TextView
                android:id="@+id/tvParse"
                android:layout_width="168dp"
                android:layout_height="26dp"
                android:ellipsize="end"
                android:lines="1"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="20dp"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:background="@drawable/bg_phrase_widget_small"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="2dp"
                tools:text="东南偏东风 3级｜湿度122434dk" />

        </LinearLayout>

    </LinearLayout>


</RelativeLayout>
